{
    "name": "PlanetHosts Default",
    "version": "2.0",
    "author": "Planet-Hosts",
    "description": "Default Planet-Hosts admin theme. Dark sidebar, dark content area, blue accents.",
    "type": "admin",
    "parent": "",
    "layouts": ["1-col", "2-col", "3-col"],
    "widget_zones": ["header", "top", "left", "center", "right", "footer"],
    "colors": {
        "primary": "#1683ff",
        "secondary": "#3bb8ff",
        "bg": "#04101f",
        "sidebar_bg": "#071a30",
        "card_bg": "linear-gradient(145deg,#0b1f39,#08192d)",
        "text": "#e8f1ff",
        "text_muted": "#8ea8c5",
        "border": "#17385b",
        "success": "#16d17e",
        "warning": "#f4ac15",
        "danger": "#ff4757"
    },
    "fonts": {
        "body": "'Inter', sans-serif",
        "heading": "'Inter', sans-serif",
        "mono": "'JetBrains Mono', monospace"
    },
    "assets": {
        "css": ["assets/css/theme.css"],
        "js": ["assets/js/theme.js"]
    }
}
