RewriteEngine On

# Direct chat room URLs — /chat/{slug} -> /chat/index.php?slug={slug}
# (skip reserved API actions: start/send/poll/upload/waiting — those route through the front controller)
RewriteCond %{REQUEST_URI} !^/chat/(start|send|poll|upload|waiting)(/|$)
RewriteRule ^chat/([a-z0-9-]+)$ chat/index.php?slug=$1 [L,QSA]

# Handle front controller — route everything except existing files to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# --- Security: deny probe/debug/backup files ---
<FilesMatch "\.(bak|orig|old|save|swp|tmp)$">
    Require all denied
</FilesMatch>
<Files "debug_login.php">
    Require all denied
</Files>
<Files "debug_upload.php">
    Require all denied
</Files>
<Files "func_test.php">
    Require all denied
</Files>
<Files "pi.php">
    Require all denied
</Files>
<Files "pma-login.php">
    Require all denied
</Files>
<Files "pma_signon.php">
    Require all denied
</Files>
<Files "upload_test.php">
    Require all denied
</Files>
